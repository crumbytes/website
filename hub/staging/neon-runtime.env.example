# Supplemental profile for the NEW isolated Hub Neon project. No secret values.
# Copy the full hub/.env.example requirements into secure Preview settings first.
# Do not source this file as proof of an approved project or connectivity.
HUB_ENV=staging
HUB_BASE_URL=https://hub-preview.crumbyte.com
VERCEL_ENV=preview
# Runtime URL uses the provider-returned NEW pooled endpoint, hub_staging database,
# SQL-created hub_runtime login, URL-encoded password, port 5432, sslmode=verify-full.
# Never use the Console-created neondb_owner role here.
DATABASE_URL=
HUB_STAGING_DATABASE_HOST=
HUB_STAGING_DATABASE_NAME=hub_staging
# Empty for Neon. A stale Supabase ref intentionally causes preflight failure.
HUB_STAGING_SUPABASE_PROJECT_REF=
HUB_OIDC_ISSUER=
HUB_STAGING_OIDC_ISSUER=
HUB_OIDC_CLIENT_ID=
HUB_STAGING_OIDC_CLIENT_ID=
HUB_OIDC_CLIENT_SECRET=
HUB_OIDC_REQUIRED_AMR=mfa
HUB_TRUSTED_IP_HEADER=x-vercel-forwarded-for
HUB_OUTBOUND_ENABLED=false
HUB_OPERATIONS_ENABLED=false
HUB_CREDENTIAL_STORAGE_ENABLED=false
HUB_STACKLTR_ENABLED=false
HUB_EMAIL_ENABLED=false
HUB_R2_ENABLED=false
HUB_JOB_SECRET=
# Never install HUB_PG_OWNER_URL, HUB_MIGRATE_CONFIRM_HOST, NEON_API_KEY or any
# migration/provider administrator credential in the Vercel runtime.
