# Website Management Hub settings. Placeholders only. Never commit real values.
# `npm run dev` needs none of these: it sets up a local database and sign-in itself.

# development, test, staging or production. Unset means production, the strictest.
HUB_ENV=staging
HUB_BASE_URL=https://hub-preview.crumbyte.com
DATABASE_URL=
# Independent approved staging pins; never use a production cluster or IdP client.
HUB_STAGING_DATABASE_HOST=
HUB_STAGING_DATABASE_NAME=
# Required for Supabase; only the separately approved NEW Hub project reference.
# Shared-pooler login is hub_runtime.<this-ref>; SQL runtime role stays hub_runtime.
HUB_STAGING_SUPABASE_PROJECT_REF=
HUB_STAGING_OIDC_ISSUER=
HUB_STAGING_OIDC_CLIENT_ID=

# OpenID Connect. Enforce MFA at the identity provider.
HUB_OIDC_ISSUER=https://identity.example.test
HUB_OIDC_CLIENT_ID=
HUB_OIDC_CLIENT_SECRET=
# Required outside local development/test. Confirm the provider emits this after MFA.
HUB_OIDC_REQUIRED_AMR=mfa

# Everything below stays off until it has been explicitly approved.
HUB_OUTBOUND_ENABLED=false
HUB_OPERATIONS_ENABLED=false
HUB_CREDENTIAL_STORAGE_ENABLED=false
# Comma-separated id:base64 pairs, each a random 32-byte key. Hold these in a secrets manager.
HUB_CREDENTIAL_KEKS=
HUB_CREDENTIAL_ACTIVE_KEY=

# Hub notification email through Resend, with its own key.
HUB_EMAIL_ENABLED=false
HUB_RESEND_API_KEY=
HUB_EMAIL_FROM=

# Read-only Cloudflare R2 listing for backup status. The hub never writes to or restores from it.
HUB_R2_ENABLED=false
HUB_R2_ACCOUNT_ID=
HUB_R2_BUCKET=
HUB_R2_ACCESS_KEY_ID=
HUB_R2_SECRET_ACCESS_KEY=

# Log level: debug, info, warn or error.
HUB_LOG_LEVEL=info
# Rate limits key on this header. Use only one the platform sets, such as x-vercel-forwarded-for.
HUB_TRUSTED_IP_HEADER=x-vercel-forwarded-for

# Bearer secret for POST /internal/jobs/run, at least 32 characters. Empty disables the route.
HUB_JOB_SECRET=

# StackLTR's side of this contract does not exist yet. See docs/stackltr-integration.md.
HUB_STACKLTR_ENABLED=false
HUB_STACKLTR_BASE_URL=
HUB_STACKLTR_TOKEN=
