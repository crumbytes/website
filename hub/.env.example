# Website Management Hub settings. Placeholders only. Never commit real values.
# `npm run dev` needs none of these: it sets up a local database and sign-in itself.

HUB_ENV=production
HUB_BASE_URL=https://hub.example.test
DATABASE_URL=

# OpenID Connect. Enforce MFA at the identity provider.
HUB_OIDC_ISSUER=https://identity.example.test
HUB_OIDC_CLIENT_ID=
HUB_OIDC_CLIENT_SECRET=
# Set to a value your provider puts in the amr claim to also enforce MFA here, such as mfa.
HUB_OIDC_REQUIRED_AMR=

# Everything below stays off until it has been explicitly approved.
HUB_OUTBOUND_ENABLED=false
HUB_OPERATIONS_ENABLED=false
HUB_CREDENTIAL_STORAGE_ENABLED=false
# Comma-separated id:base64 pairs, each a random 32-byte key. Hold these in a secrets manager.
HUB_CREDENTIAL_KEKS=
HUB_CREDENTIAL_ACTIVE_KEY=

# Bearer secret for POST /internal/jobs/run, at least 32 characters. Empty disables the route.
HUB_JOB_SECRET=

# StackLTR's side of this contract does not exist yet. See docs/stackltr-integration.md.
HUB_STACKLTR_ENABLED=false
HUB_STACKLTR_BASE_URL=
HUB_STACKLTR_TOKEN=
