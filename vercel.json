{
  "git": {
    "deploymentEnabled": {
      "feat/website-hub-foundation-20261101": false,
      "codex/hub-staging-review": false,
      "codex/hub-frontend-integration": false,
      "codex/hub-release-candidate": false
    }
  },
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.crumbyte.com"
        }
      ],
      "destination": "https://crumbyte.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(admin|portal|admin.html|portal.html)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
